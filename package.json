{
  "name": "izin",
  "version": "1.0.2",
  "private": true,
  "description": "GO / ASK / NO-GO for one AI agent action on one website, with the site's own terms quoted exactly.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup",
    "build:web": "vite build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gate": "bash scripts/gerbang-ujian.sh",
    "check": "tsx scripts/check.ts",
    "readability": "tsx scripts/readability.ts",
    "ukur": "tsx scripts/ukur.ts",
    "remeasure": "tsx scripts/remeasure.ts",
    "reread": "tsx scripts/reread.ts",
    "g1": "tsx scripts/g1.ts",
    "gallery": "tsx scripts/gallery.ts",
    "prime": "tsx scripts/prime.ts",
    "bench": "tsx scripts/bench.ts",
    "bench-merge": "tsx scripts/bench-merge.ts",
    "mcp-check": "tsx scripts/mcp-check.ts",
    "video": "tsx scripts/video.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/fastify": "2.29.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "openai": "^7.54.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@x402/fetch": "2.29.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "viem": "2.57.13",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
