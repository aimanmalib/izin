    "account": ["account_automation", "automated_access", "agent_identification", "permission_grant"],
    "purchase": ["purchase_automation", "automated_access", "account_automation", "agent_identification", "permission_grant"],
    "post": ["posting_automation", "automated_access", "account_automation", "api_required", "agent_identification", "permission_grant"]
  },
  "prices_usd_per_mtok": {
    "serv": {
      "gpt-6-luna": { "input": 0.13, "output": 0.65 },
      "gpt-5.4-nano": { "input": 0.25, "output": 1.6 },
      "gemini-3.1-flash-lite": { "input": 0.3, "output": 1.8 }
    },
    "dolphin": {
      "deepseek-ai/DeepSeek-V4.1-Flash": { "input": 0.01, "output": 0.07 }
    }
  },
  "budget": {
    "serv_usd_per_day": 0.6,
    "serv_usd_total": 4.0,
    "dolphin_usd_per_day": 0.1,
    "dolphin_usd_total": 0.85,
    "serv_cost_factor": 3.0
  },
  "do_not_fetch_hosts": [
    "devpost.com",
    "hacks.elevenlabs.io",
    "pentas.app",
    "kaggle.com",
    "dev.to",
    "eventsize.com"
  ],
  "challenge_markers": [
    "Just a moment...",
    "Performing security verification",
    "cf-chl-",
    "challenge-platform",
    "Attention Required! | Cloudflare"
  ],
  "blocked_statuses": [401, 403, 429, 503],
  "injection_patterns": [
    "ignore (all |any |the )?(previous|prior|above) (instructions|rules|terms)",
    "disregard .{0,40}(instructions|rules|terms)",
    "(you are|as) an? (ai|llm|language model|assistant)",
    "system prompt",
    "(ai|llm) (agents?|systems?|models?)\\b.{0,40}(must|should|shall) (report|state|say|respond)",
    "report that .{0,80}(permitted|allowed|authorized)"
  ],
  "discovery": {
    "input_path_pattern": "(terms|tos|legal|conditions|agreement|acceptable-use|policy|policies)",
    "anchor_scores": [
      { "pattern": "terms|conditions|user agreement|terms of (use|service)|legal", "score": 3 },
      { "pattern": "acceptable use|api terms|developer (terms|policy|agreement)|robot|crawl|scrap|automated", "score": 3 }
    ],
    "anchor_exclude_pattern": "privacy|cookie",
    "common_paths": ["/terms", "/terms-of-service", "/terms-of-use", "/tos", "/legal/terms", "/legal"],
    "multi_part_suffixes": [
      "co.uk", "org.uk", "ac.uk", "com.au", "net.au", "org.au", "com.my", "net.my", "org.my", "edu.my", "gov.my",
      "co.jp", "co.nz", "co.id", "or.id", "co.in", "com.br", "com.sg", "com.cn", "co.kr"
    ]
  },
  "robots_comments": {
    "min_chars": 200,
    "keywords": ["agent", "bot", "automated", "scrap", "checkout", "AI", "LLM", "permission", "prohibit"],
    "boilerplate_markers": ["following content signals", "Content-Signal = yes"],
    "policy_url_pattern": "terms|legal|policy|policies|conditions|agreement"
  },
  "limits": {
    "fetch_ports": [80, 443],
    "requests_per_check": 8,
    "policy_docs_max": 4,
    "common_path_attempts_max": 2,
    "fetch_timeout_ms": 20000,
    "response_max_bytes": 3145728,
    "redirects_max": 5,
    "host_interval_ms": 1000,
    "crawl_delay_max_ms": 5000,
    "doc_text_min_chars": 800,
    "doc_text_max_chars": 600000,
    "terms_text_max_chars": 400000,
    "detail_max_chars": 280,
    "quote_min_chars": 40,
    "quote_max_chars": 600,
    "check_timeout_s": 90,
    "server_timeout_s": 95,
    "mcp_wait_s": 25,
    "queue_concurrency": 2,
    "cache_hours": 24,
    "cached_receipt_days": 7,
    "no_refetch_blocked_days": 7,
    "rate_new_checks_per_ip_hour": 6,
    "rate_new_checks_per_day": 300
  },
  "reader": {
    "primary": {
      "provider": "dolphin",
      "base_url": "https://lighthouse.dphn.ai/run/text-v/v1",
      "model": "deepseek-ai/DeepSeek-V4.1-Flash",
      "key_env": "DOLPHIN_API_KEY",
      "stream": true
    },
    "fallback": {
      "provider": "serv",
      "base_url": "https://inference-api.openserv.ai/v1",
      "model": "gpt-6-luna",
      "key_env": "SERV_API_KEY",
      "stream": false
    },
    "prompt": "reader.v1",
    "temperature": 0,
    "max_tokens": 6000,
    "timeout_ms": 120000,
    "retry_after_max_s": 20,
    "json_retry_note": "Return the JSON object only.",
    "fallback_suspect_markers": ["openrouter"],
    "max_clauses": 25,
    "fragment_words": 8,
    "quarantine_max_chars": 600
  },
  "decider": {
    "base_url": "https://inference-api.openserv.ai/v1",
    "model": "gpt-6-luna-serv-multipath",
    "suffix": "-serv-multipath",
    "key_env": "SERV_API_KEY",
    "prompt": "decider.v1",
    "reasoning_effort": "low",
    "timeout_ms": 60000,
    "retries": 1,
    "retry_backoff_ms": 3000,
    "start_rung": "a",
    "max_calls": 5,
    "shadow_hint": "The answer must be valid JSON for the schema. A NO_GO must cite at least one clause id whose stance is prohibits or name a machine-readable signal. An ASK must list at least one condition or one missing item. A GO must not cite any prohibiting clause. Every cited id must exist in the request.",
    "shadow_max_iterations": 2,
    "json_prompt_note": "Return one JSON object only, with exactly these keys: verdict (GO, ASK or NO_GO), decisive_clause_ids (array of clause ids, at most 4), reason (string), conditions (array of strings, at most 3), missing (array of strings, at most 3), confidence (high, medium or low), rules_applied (array of rule ids R1 to R10).",
    "max_clauses": 20,
    "stance_priority": { "prohibits": 0, "restricts": 1, "requires": 1, "permits": 2, "unclear": 3 },
    "max_decisive": 4,
    "max_conditions": 3,
    "max_missing": 3,
    "guard_refusal_markers": ["prompt injection", "injection attempt", "cannot help with that", "can't help with that", "unable to comply"],
    "shadow_exhausted_markers": ["exhausted"]
  },
  "receipt": { "id_length": 10, "version": "0.1.0" },
  "alerts": { "command_env": "IZIN_NOTIFY_CMD", "language": "ms", "level": "warn" }
}
