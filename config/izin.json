    "permission_grant",
    "other"
  ],
  "stances": ["prohibits", "restricts", "requires", "permits", "unclear"],
  "verdicts": ["NO_GO", "ASK", "GO"],
  "relevance": {
    "read_page": ["automated_access", "rate_limit", "agent_identification", "permission_grant"],
    "crawl": ["automated_access", "data_collection", "api_required", "rate_limit", "agent_identification", "permission_grant"],
