{
  "version": 1,
  "user_agent": "IzinBot/0.1 (+https://izin.sasateguh.com/bot)",
  "public_origin": "https://izin.sasateguh.com",
  "actions": ["read_page", "crawl", "train", "account", "purchase", "post"],
  "categories": [
    "automated_access",
