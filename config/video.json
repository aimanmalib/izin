{
  "size": { "width": 1920, "height": 1080 },
  "viewport": { "width": 1280, "height": 720 },
  "fps": 30,
  "caption": { "font_size": 46, "wrap_chars": 52, "bottom_px": 64, "speed_label_min": 1.3 },
  "fonts": {
    "sans": ["/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf"],
    "mono": ["/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", "/usr/share/fonts/TTF/DejaVuSansMono.ttf"]
  },
  "limits": { "min_s": 55, "max_s": 90, "freeze_s": 5, "scene_max_s": 18 },
  "robots": {
    "site": "https://www.ebay.com/",
    "block_marker": "Robots & Agent Policy",
    "probe_path": "/itm/1234567890",
    "context_lines": 2
  },
  "receipts": { "main": "ebay_buy" },
  "trap": { "button": "section[aria-labelledby=\"trap-2\"] button", "timeout_s": 240 },
  "mcp": { "url": "https://ebay.com/", "action": "purchase" },
  "ukur_baseline": "\\*\\*(\\d+) of (\\d+)\\*\\*",
  "scenes": [
    { "key": "robots", "seconds": 6, "caption": "eBay's robots.txt. Parsers skip this comment." },
    { "key": "home", "seconds": 8, "caption": "One site. One action." },
    { "key": "verdict", "seconds": 16, "caption": "{verdict}. The clause, word for word. Read on Dolphin, decided with SERV Reasoning." },
    { "key": "trap", "seconds": 18, "caption": "A hidden line tells AI readers to say yes. Izin sets it aside." },
    { "key": "gallery", "seconds": 12, "caption": "Gallery: in {k} of {m} checks robots.txt allowed, the site's own words did not." },
    { "key": "mcp", "seconds": 12, "caption": "One line for your agent." },
    { "key": "end", "seconds": 8, "caption": "Reads on Dolphin. Decides with SERV Reasoning. Code has the last word." }
  ],
  "text": {
    "robots_title": "robots.txt, read {date} UTC as {ua}",
    "parser_head": "A robots.txt parser, for {url}",
    "parser_allowed": "allowed",
    "parser_disallowed": "disallowed",
    "end_lines": ["Izin", "GO / ASK / NO-GO for one agent action on one site, with the clause quoted.", "{origin}"]
  }
}
