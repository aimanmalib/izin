# Copy to .env (never commit .env). Leave empty to run with IZIN_FAKE=1 and recorded fixtures.
SERV_API_KEY=
DOLPHIN_API_KEY=
# SQLite file for checks, receipts and spending (in memory when unset). The container uses its data volume.
IZIN_DB=
# Optional: receiving address for the paid route (x402, Base Sepolia testnet; ADR 0022). Empty = no paid route.
IZIN_X402_PAY_TO=
